#!/usr/bin/env bash
# Block pushes that introduce bot attribution or non-reagan-pius authors.
set -euo pipefail

EXPECTED_NAME="reagan-pius"
EXPECTED_EMAIL="reaganpius05@gmail.com"
BOT_PATTERN='(?i)Co-authored-by:.*(Cursor|cursoragent|\[bot\])|Signed-off-by:[[:space:]]*Cursor'

zero=0000000000000000000000000000000000000000
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # delete

  if [[ "$remote_sha" == "$zero" ]]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi

  while IFS= read -r sha; do
    [[ -z "$sha" ]] && continue
    an=$(git log -1 --format='%an' "$sha")
    ae=$(git log -1 --format='%ae' "$sha")
    cn=$(git log -1 --format='%cn' "$sha")
    ce=$(git log -1 --format='%ce' "$sha")
    body=$(git log -1 --format='%B' "$sha")

    if [[ "$an" != "$EXPECTED_NAME" || "$ae" != "$EXPECTED_EMAIL" ]]; then
      echo "pre-push: $sha author is '$an <$ae>', expected '$EXPECTED_NAME <$EXPECTED_EMAIL>'" >&2
      fail=1
    fi
    if [[ "$cn" != "$EXPECTED_NAME" || "$ce" != "$EXPECTED_EMAIL" ]]; then
      echo "pre-push: $sha committer is '$cn <$ce>', expected '$EXPECTED_NAME <$EXPECTED_EMAIL>'" >&2
      fail=1
    fi
    if printf '%s\n' "$body" | grep -Eiq "$BOT_PATTERN"; then
      echo "pre-push: $sha contains bot attribution trailer — strip before pushing" >&2
      fail=1
    fi
  done < <(git rev-list "$range")
done

if [[ "$fail" -ne 0 ]]; then
  echo "pre-push: blocked. Attribute as $EXPECTED_NAME <$EXPECTED_EMAIL> and remove Cursor/bot trailers." >&2
  exit 1
fi

exit 0
